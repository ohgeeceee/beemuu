{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beemuu.com/evidence/schema.json",
  "title": "Beemuu CAN Evidence Pack",
  "description": "Real-car CAN frame capture with expected decoder output for v0.22 validation.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "data", "expected", "source", "captured_at"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^0x[0-9A-Fa-f]{1,4}$",
        "description": "CAN arbitration ID as a hex string (e.g. 0x0AA)."
      },
      "data": {
        "type": "array",
        "items": { "type": "integer", "minimum": 0, "maximum": 255 },
        "minItems": 8,
        "maxItems": 8,
        "description": "8-byte CAN payload."
      },
      "expected": {
        "type": "object",
        "additionalProperties": { "type": ["number", "boolean", "string"] },
        "description": "Decoded values the decoder must produce for this frame."
      },
      "source": {
        "type": "string",
        "minLength": 5,
        "description": "Provenance: vehicle, cable type, capture tool."
      },
      "captured_at": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 timestamp of the capture."
      },
      "vehicle": {
        "type": "object",
        "properties": {
          "vin": { "type": "string", "minLength": 17, "maxLength": 17 },
          "wmi": { "type": "string", "minLength": 3, "maxLength": 3 },
          "serial_last6": { "type": "string", "minLength": 6, "maxLength": 6 },
          "engine": { "type": "string" },
          "chassis": { "type": "string" }
        },
        "description": "Vehicle identification. VIN preferred; WMI+serial_last6 acceptable for privacy."
      },
      "notes": {
        "type": "string",
        "description": "Free-text notes on capture conditions (warm/cold, idle/load, etc.)."
      }
    }
  }
}
