{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeeEmUu",
  "version": "5.0.1",
  "identifier": "com.beeemuu.diag",
  "build": {
    "beforeBuildCommand": "npm run build:auto-update",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BeeEmUu Diagnostics",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; worker-src blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.beemuu.com; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMDA5MTY4OEFCNkYzRUQKUldUdDg3YUthSkVBN2ZBd2ZTSnZMcG5xWUlWUnR3ZXlIN3FmOUZuSWlPWFpSYjMxOGxyYWJJenQK",
      "endpoints": [
        "https://github.com/ohgeeceee/beemuu/releases/latest/download/latest.json"
      ]
    }
  }
}
